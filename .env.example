# Optional. Without these, the app runs fully local (localStorage + IndexedDB).
# Set them once a Supabase project is provisioned for this app specifically —
# do not point this at an unrelated existing project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Without this, the AI Music Assistant (natural-language commands,
# "Assistant" tab) shows as "not configured" and the rest of the app works
# normally — see AI_FEATURES.md principle 1 (AI must be optional). Server-only,
# never exposed to the browser: read exclusively by src/app/api/assistant/route.ts.
ANTHROPIC_API_KEY=
# Optional override of the model the assistant route calls. Defaults to a
# current Claude model if unset — see src/app/api/assistant/route.ts.
ANTHROPIC_ASSISTANT_MODEL=
